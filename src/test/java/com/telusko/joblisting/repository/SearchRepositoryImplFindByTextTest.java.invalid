        when(collection.aggregate(anyList())).thenReturn(aggregateIterable);
        when(aggregateIterable.iterator()).thenReturn(Collections.emptyIterator());
        when(aggregateIterable.spliterator()).thenReturn(Collections.emptyList().spliterator());
        List<Post> result = searchRepository.findByText("");
        assertTrue(result.isEmpty());
    }
