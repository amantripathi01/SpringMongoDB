    @Test
    @Tag("valid")
    void findsPostsByText() {
        // Arrange
        MongoDatabase database = mock(MongoDatabase.class);
        MongoCollection<Document> collection = mock(MongoCollection.class);
        AggregateIterable<Document> result = mock(AggregateIterable.class);
        when(client.getDatabase(anyString())).thenReturn(database);
        when(database.getCollection(anyString())).thenReturn(collection);
        when(collection.aggregate(anyList())).thenReturn(result);
        Post post1 = new Post();
        Post post2 = new Post();
        when(converter.read(Post.class, any(Document.class))).thenReturn(post1, post2);
        List<Document> documents = Arrays.asList(new Document(), new Document());
        when(result.iterator()).thenReturn(documents.iterator());
        // Act
        List<Post> posts = searchRepository.findByText("java");
        // Assert
        assertEquals(2, posts.size());
        assertTrue(posts.contains(post1));
        assertTrue(posts.contains(post2));
    }
