package com.telusko.joblisting.repository;import com.mongodb.client.AggregateIterable;
import com.mongodb.client.MongoClient;
import com.mongodb.client.MongoCollection;
import com.mongodb.client.MongoDatabase;
import com.telusko.joblisting.model.Post;
import org.bson.Document;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.Mockito;
import org.mockito.junit.jupiter.MockitoExtension;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.data.mongodb.core.convert.MongoConverter;
import org.springframework.stereotype.Component;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertThrows;
import org.junit.jupiter.api.*;

@ExtendWith(MockitoExtension.class)
public class SearchRepositoryImplFindByTextTest {
    @Mock
    private MongoClient client;
    @Mock
    private MongoConverter converter;
    @InjectMocks
    private SearchRepositoryImpl searchRepository;
    @Test
    @Tag("valid")
    public void normalOperationReturnPostTest() {
        // Arrange
        MongoDatabase mockDatabase = Mockito.mock(MongoDatabase.class);
        Mockito.when(client.getDatabase(Mockito.anyString())).thenReturn(mockDatabase);
        MongoCollection mockCollection = Mockito.mock(MongoCollection.class);
        Mockito.when(mockDatabase.getCollection(Mockito.anyString())).thenReturn(mockCollection);
        AggregateIterable<Document> mockIterable = Mockito.mock(AggregateIterable.class);
        Mockito.when(mockCollection.aggregate(Mockito.any())).thenReturn(mockIterable);
        Mockito.when(mockIterable.iterator()).thenReturn(Collections.<Document>singleton(new Document()).iterator());
        Post post = new Post();
        Mockito.when(converter.read(Post.class, new Document())).thenReturn(post);
        // Act
        List<Post> result = searchRepository.findByText("test");
        // Assert
        assertEquals(1, result.size());
        assertEquals(post, result.get(0));
    }
    @Test
    @Tag("valid")
    public void normalOperationReturnEmptyTest() {
        // Arrange
        MongoDatabase mockDatabase = Mockito.mock(MongoDatabase.class);
        Mockito.when(client.getDatabase(Mockito.anyString())).thenReturn(mockDatabase);
        MongoCollection mockCollection = Mockito.mock(MongoCollection.class);
        Mockito.when(mockDatabase.getCollection(Mockito.anyString())).thenReturn(mockCollection);
        AggregateIterable<Document> mockIterable = Mockito.mock(AggregateIterable.class);
        Mockito.when(mockCollection.aggregate(Mockito.any())).thenReturn(mockIterable);
        Mockito.when(mockIterable.iterator()).thenReturn(Collections.<Document>emptyIterator());
        // Act
        List<Post> result = searchRepository.findByText("test");
        // Assert
        assertEquals(0, result.size());
    }
    @Test
    @Tag("invalid")
    public void errorAccessingDataStoreTest() {
        // Arrange
        Mockito.when(client.getDatabase(Mockito.anyString())).thenThrow(RuntimeException.class);
        // Act & Assert
        assertThrows(RuntimeException.class, () -> searchRepository.findByText("test"));
    }
    @Test
    @Tag("invalid")
    public void nullParameterPassedTest() {
        // Act & Assert
        assertThrows(IllegalArgumentException.class, () -> searchRepository.findByText(null));
    }
}