package com.telusko.joblisting.repository;import com.mongodb.client.AggregateIterable;
import com.mongodb.client.MongoClient;
import com.mongodb.client.MongoCollection;
import com.mongodb.client.MongoDatabase;
import com.telusko.joblisting.model.Post;
import org.bson.Document;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.mockito.Mockito;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.data.mongodb.core.convert.MongoConverter;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertTrue;
import static org.junit.jupiter.api.Assertions.assertThrows;
import static org.mockito.Mockito.when;
import org.springframework.stereotype.Component;

public class SearchRepositoryImplFindByTextTest { 
   @Autowired 
   MongoClient client; 
   @Autowired 
   MongoConverter converter;
   @Test
   @Tag("valid")
   public void findByTextWithExistingText() {
      String text = "existingText"; 
	   
      Post post1 = new Post(), post2 = new Post();
      post1.setPostId(1);
      post1.setText(text);
      post2.setPostId(2);
      post2.setText(text);
      ArrayList<Post> expectedList = new ArrayList<>(Arrays.asList(post1, post2));
	   
      MongoDatabase database = Mockito.mock(MongoDatabase.class); 
      MongoCollection<Document> collection = Mockito.mock(MongoCollection.class);
      AggregateIterable<Document> aggregateIterable = Mockito.mock(AggregateIterable.class);
      
      when(client.getDatabase("telusko")).thenReturn(database); 
      when(database.getCollection("JobPost")).thenReturn(collection);
      when(collection.aggregate(Mockito.anyList())).thenReturn(aggregateIterable);
      when(aggregateIterable.iterator().hasNext()).thenReturn(true, true, false);
      when(aggregateIterable.iterator().next()).thenReturn(new Document(), new Document());
      when(converter.read(Post.class, new Document())).thenReturn(post1, post2);
      SearchRepositoryImpl searchRepository = new SearchRepositoryImpl();
      searchRepository.client = this.client;
      searchRepository.converter = this.converter;
      List<Post> resultList = searchRepository.findByText(text);
      assertEquals(expectedList, resultList);
   }
   
   @Test
   @Tag("valid") 
   public void findByTextWithNonExistingText() {
      String text = "nonExistingText"; 
	   
      MongoDatabase database = Mockito.mock(MongoDatabase.class); 
      MongoCollection<Document> collection = Mockito.mock(MongoCollection.class);
      AggregateIterable<Document> aggregateIterable = Mockito.mock(AggregateIterable.class);
	   
      when(client.getDatabase("telusko")).thenReturn(database); 
      when(database.getCollection("JobPost")).thenReturn(collection);
      when(collection.aggregate(Mockito.anyList())).thenReturn(aggregateIterable);
      when(aggregateIterable.iterator().hasNext()).thenReturn(false);
	   
      SearchRepositoryImpl searchRepository = new SearchRepositoryImpl();
      searchRepository.client = this.client;
      searchRepository.converter = this.converter;
      List<Post> resultList = searchRepository.findByText(text);
      assertTrue(resultList.isEmpty()); 
   } 
   @Test
   @Tag("invalid") 
   public void findByTextWithNullText() { 
      assertThrows(NullPointerException.class, () -> { 
         SearchRepositoryImpl searchRepository = new SearchRepositoryImpl();
         searchRepository.client = this.client;
         searchRepository.converter = this.converter;
         searchRepository.findByText(null);
      });
   }
}