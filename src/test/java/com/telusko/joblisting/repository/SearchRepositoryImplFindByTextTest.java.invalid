package com.telusko.joblisting.repository;import com.mongodb.client.AggregateIterable;
import com.mongodb.client.MongoClient;
import com.mongodb.client.MongoCollection;
import com.mongodb.client.MongoDatabase;
import com.telusko.joblisting.model.Post;
import org.bson.Document;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import org.springframework.data.mongodb.core.convert.MongoConverter;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.ArgumentMatchers.anyString;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Component;

@ExtendWith(MockitoExtension.class)
class SearchRepositoryImplFindByTextTest {
    @Mock
    private MongoClient client;
    @Mock
    private MongoConverter converter;
    @Mock
    private MongoDatabase database;
    @Mock
    private MongoCollection<Document> collection;
    @Mock
    private AggregateIterable<Document> aggregateIterable;
    @InjectMocks
    private SearchRepositoryImpl searchRepository;
    
    @BeforeEach
    void setUp() {
        when(client.getDatabase(anyString())).thenReturn(database);
        when(database.getCollection(anyString())).thenReturn(collection);
        when(collection.aggregate(any())).thenReturn(aggregateIterable);
    }
    
    @Test
    @Tag("valid")
    void findByTextWithValidQuery() {
        Document doc1 = new Document("techs", "Java").append("exp", 2);
        Document doc2 = new Document("techs", "Spring").append("exp", 1);
        List<Document> documents = Arrays.asList(doc1, doc2);
        
        when(aggregateIterable.iterator()).thenReturn(documents.iterator());
        when(converter.read(Post.class, doc1)).thenReturn(new Post());
        when(converter.read(Post.class, doc2)).thenReturn(new Post());
        
        List<Post> result = searchRepository.findByText("Java");
        
        assertNotNull(result);
        assertFalse(result.isEmpty());
        assertTrue(result.size() <= 5);
    }
    
    @Test
    @Tag("invalid")
    void findByTextWithEmptyString() {
        List<Post> result = searchRepository.findByText("");
        
        assertNotNull(result);
        assertTrue(result.isEmpty());
    }
    
    @Test
    @Tag("invalid")
    void findByTextWithNoMatches() {
        when(aggregateIterable.iterator()).thenReturn(new ArrayList<Document>().iterator());
        
        List<Post> result = searchRepository.findByText("NonexistentTerm");
        
        assertNotNull(result);
        assertTrue(result.isEmpty());
    }
    
    @Test
    @Tag("valid")
    void findByTextResultsSortedByExperience() {
        Document doc1 = new Document("techs", "Java").append("exp", 3);
        Document doc2 = new Document("techs", "Spring").append("exp", 1);
        Document doc3 = new Document("techs", "MongoDB").append("exp", 2);
        List<Document> documents = Arrays.asList(doc1, doc2, doc3);
        
        when(aggregateIterable.iterator()).thenReturn(documents.iterator());
        when(converter.read(eq(Post.class), any(Document.class))).thenReturn(new Post());
        
        List<Post> result = searchRepository.findByText("Java");
        
        assertNotNull(result);
        assertEquals(1, result.get(0).getExp());
        assertEquals(2, result.get(1).getExp());
        assertEquals(3, result.get(2).getExp());
    }
    
    @Test
    @Tag("boundary")
    void findByTextReturnsMaximumFiveResults() {
        List<Document> documents = new ArrayList<>();
        for (int i = 0; i < 10; i++) {
            documents.add(new Document("techs", "Java" + i).append("exp", i));
        }
        
        when(aggregateIterable.iterator()).thenReturn(documents.iterator());
        when(converter.read(eq(Post.class), any(Document.class))).thenReturn(new Post());
        
        List<Post> result = searchRepository.findByText("Java");
        
        assertNotNull(result);
        assertEquals(5, result.size());
    }
    
    @Test
    @Tag("integration")
    void findByTextHandlesDatabaseFailure() {
        when(client.getDatabase(anyString())).thenThrow(new RuntimeException("Connection failed"));
        
        assertThrows(RuntimeException.class, () -> {
            searchRepository.findByText("Java");
        });
    }
    
    @Test
    @Tag("valid")
    void findByTextWithSpecialCharacters() {
        Document doc = new Document("techs", "C#").append("exp", 2);
        List<Document> documents = Arrays.asList(doc);
        
        when(aggregateIterable.iterator()).thenReturn(documents.iterator());
        when(converter.read(Post.class, doc)).thenReturn(new Post());
        
        List<Post> result = searchRepository.findByText("C#");
        
        assertNotNull(result);
        assertFalse(result.isEmpty());
    }
    
    @Test
    @Tag("integration")
    void findByTextHandlesConversionError() {
        Document doc = new Document("techs", "Java").append("exp", 2);
        List<Document> documents = Arrays.asList(doc);
        
        when(aggregateIterable.iterator()).thenReturn(documents.iterator());
        when(converter.read(Post.class, doc)).thenThrow(new RuntimeException("Conversion error"));
        
        assertThrows(RuntimeException.class, () -> {
            searchRepository.findByText("Java");
        });
    }
    
    @Test
    @Tag("valid")
    void findByTextSearchesAllTargetFields() {
        Document doc1 = new Document("techs", "Java").append("exp", 1);
        Document doc2 = new Document("desc", "Java developer").append("exp", 2);
        Document doc3 = new Document("profile", "Java architect").append("exp", 3);
        List<Document> documents = Arrays.asList(doc1, doc2, doc3);
        
        when(aggregateIterable.iterator()).thenReturn(documents.iterator());
        when(converter.read(eq(Post.class), any(Document.class))).thenReturn(new Post());
        
        List<Post> result = searchRepository.findByText("Java");
        
        assertNotNull(result);
        assertEquals(3, result.size());
    }
}