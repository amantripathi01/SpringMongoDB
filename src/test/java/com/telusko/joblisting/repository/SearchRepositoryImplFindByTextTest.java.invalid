    @InjectMocks
    private SearchRepositoryImpl searchRepository;
    @BeforeEach
    void setUp() {
        when(client.getDatabase("telusko")).thenReturn(database);
        when(database.getCollection("JobPost")).thenReturn(collection);
    }
    @Test
    @Tag("valid")
    public void validSearchQueryReturnsExpectedPosts() {
        Document doc1 = new Document();
        Document doc2 = new Document();
        Post post1 = new Post(); // TODO: Set necessary fields
        Post post2 = new Post(); // TODO: Set necessary fields
        when(collection.aggregate(anyList())).thenReturn(aggregateIterable);
        when(aggregateIterable.iterator()).thenReturn(Arrays.asList(doc1, doc2).iterator());
        when(aggregateIterable.spliterator()).thenReturn(Arrays.asList(doc1, doc2).spliterator());
        when(converter.read(Post.class, doc1)).thenReturn(post1);
        when(converter.read(Post.class, doc2)).thenReturn(post2);
        List<Post> result = searchRepository.findByText("Java Developer");
        assertEquals(2, result.size());
        assertTrue(result.contains(post1));
        assertTrue(result.contains(post2));
    }
    @Test
