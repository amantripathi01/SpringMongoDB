package com.telusko.joblisting.repository;import com.mongodb.client.AggregateIterable;
import com.mongodb.client.MongoClient;
import com.mongodb.client.MongoCollection;
import com.mongodb.client.MongoDatabase;
import com.telusko.joblisting.model.Post;
import org.bson.Document;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import org.springframework.data.mongodb.core.convert.MongoConverter;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.*;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Component;

@ExtendWith(MockitoExtension.class)
public class SearchRepositoryImplFindByTextTest {
    @Mock
    private MongoClient client;
    @Mock
    private MongoConverter converter;
    @InjectMocks
    private SearchRepositoryImpl searchRepository;
    private MongoDatabase database;
    private MongoCollection<Document> collection;
    @BeforeEach
    public void setUp() {
        database = mock(MongoDatabase.class);
        collection = mock(MongoCollection.class);
        when(client.getDatabase(anyString())).thenReturn(database);
        when(database.getCollection(anyString())).thenReturn(collection);
    }
    @Test
    @Tag("valid")
    public void testFindsPostsByText() {
        List<Document> mockDocuments = Arrays.asList(new Document(), new Document());
        AggregateIterable<Document> result = mock(AggregateIterable.class);
        when(collection.aggregate(anyList())).thenReturn(result);
        when(result.iterator()).thenReturn(mockDocuments.iterator());
        Post post1 = new Post();
        Post post2 = new Post();
        when(converter.read(Post.class, mockDocuments.get(0))).thenReturn(post1);
        when(converter.read(Post.class, mockDocuments.get(1))).thenReturn(post2);
        List<Post> posts = searchRepository.findByText("Java");
        assertNotNull(posts);
        assertEquals(2, posts.size());
        assertTrue(posts.containsAll(Arrays.asList(post1, post2)));
    }
    @Test
    @Tag("valid")
    public void testReturnsEmptyListWhenNoPostsMatch() {
        AggregateIterable<Document> result = mock(AggregateIterable.class);
        when(collection.aggregate(anyList())).thenReturn(result);
        when(result.iterator()).thenReturn(new ArrayList<Document>().iterator());
        List<Post> posts = searchRepository.findByText("NonExistent");
        assertNotNull(posts);
        assertTrue(posts.isEmpty());
    }
    @Test
    @Tag("invalid")
    public void testHandlesNullSearchText() {
        List<Post> posts = searchRepository.findByText(null);
        assertNotNull(posts);
        assertTrue(posts.isEmpty());
    }
    @Test
    @Tag("valid")
    public void testLimitsResultsToTopFivePosts() {
        List<Document> mockDocuments = Arrays.asList(new Document(), new Document(), new Document(), new Document(), new Document(), new Document());
        AggregateIterable<Document> result = mock(AggregateIterable.class);
        when(collection.aggregate(anyList())).thenReturn(result);
        when(result.iterator()).thenReturn(((Iterable<Document>) mockDocuments).iterator());
        when(converter.read(Post.class, any())).thenReturn(new Post());
        List<Post> posts = searchRepository.findByText("Java");
        assertNotNull(posts);
        assertEquals(5, posts.size());
    }
    @Test
    @Tag("valid")
    public void testSortsResultsByExperienceAscending() {
        List<Document> mockDocuments = Arrays.asList(new Document("exp", 5), new Document("exp", 3), new Document("exp", 7));
        AggregateIterable<Document> result = mock(AggregateIterable.class);
        when(collection.aggregate(anyList())).thenReturn(result);
        when(result.iterator()).thenReturn(((Iterable<Document>) mockDocuments).iterator());
        Post post1 = new Post();
        post1.setExp(3);
        Post post2 = new Post();
        post2.setExp(5);
        Post post3 = new Post();
        post3.setExp(7);
        when(converter.read(Post.class, mockDocuments.get(0))).thenReturn(post2);
        when(converter.read(Post.class, mockDocuments.get(1))).thenReturn(post1);
        when(converter.read(Post.class, mockDocuments.get(2))).thenReturn(post3);
        List<Post> posts = searchRepository.findByText("Java");
        assertNotNull(posts);
        assertEquals(3, posts.size());
        assertEquals(Arrays.asList(post1, post2, post3), posts);
    }
    @Test
    @Tag("valid")
    public void testReturnsEmptyListWhenCollectionIsEmpty() {
        AggregateIterable<Document> result = mock(AggregateIterable.class);
        when(collection.aggregate(anyList())).thenReturn(result);
        when(result.iterator()).thenReturn(new ArrayList<Document>().iterator());
        List<Post> posts = searchRepository.findByText("Java");
        assertNotNull(posts);
        assertTrue(posts.isEmpty());
    }
    @Test
    @Tag("valid")
    public void testHandlesCaseSensitivityInSearchText() {
        List<Document> mockDocuments = Arrays.asList(new Document("profile", "Java Developer"), new Document("profile", "java developer"));
        AggregateIterable<Document> result = mock(AggregateIterable.class);
        when(collection.aggregate(anyList())).thenReturn(result);
        when(result.iterator()).thenReturn(((Iterable<Document>) mockDocuments).iterator());
        Post post1 = new Post();
        Post post2 = new Post();
        when(converter.read(Post.class, mockDocuments.get(0))).thenReturn(post1);
        when(converter.read(Post.class, mockDocuments.get(1))).thenReturn(post2);
        List<Post> posts = searchRepository.findByText("java");
        assertNotNull(posts);
        assertEquals(2, posts.size());
        assertTrue(posts.containsAll(Arrays.asList(post1, post2)));
    }
    @Test
    @Tag("valid")
    public void testHandlesMongoClientException() {
        when(client.getDatabase(anyString())).thenThrow(new RuntimeException("Mocked Exception"));
        List<Post> posts = searchRepository.findByText("Java");
        assertNotNull(posts);
        assertTrue(posts.isEmpty());
    }
    @Test
    @Tag("valid")
    public void testHandlesSpecialCharactersInSearchText() {
        List<Document> mockDocuments = Arrays.asList(new Document("profile", "Java$Developer"));
        AggregateIterable<Document> result = mock(AggregateIterable.class);
        when(collection.aggregate(anyList())).thenReturn(result);
        when(result.iterator()).thenReturn(((Iterable<Document>) mockDocuments).iterator());
        Post post = new Post();
        when(converter.read(Post.class, mockDocuments.get(0))).thenReturn(post);
        List<Post> posts = searchRepository.findByText("Java$");
        assertNotNull(posts);
        assertEquals(1, posts.size());
        assertTrue(posts.contains(post));
    }
    @Test
    @Tag("valid")
    public void testHandlesMongoConverterException() {
        List<Document> mockDocuments = Arrays.asList(new Document());
        AggregateIterable<Document> result = mock(AggregateIterable.class);
        when(collection.aggregate(anyList())).thenReturn(result);
        when(result.iterator()).thenReturn(((Iterable<Document>) mockDocuments).iterator());
        when(converter.read(Post.class, any())).thenThrow(new RuntimeException("Mocked Exception"));
        List<Post> posts = searchRepository.findByText("Java");
        assertNotNull(posts);
        assertTrue(posts.isEmpty());
    }
}