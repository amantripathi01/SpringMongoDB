        when(aggregateIterable.iterator()).thenReturn(Collections.emptyIterator());
        when(aggregateIterable.spliterator()).thenReturn(Collections.emptyList().spliterator());
        List<Post> result = searchRepository.findByText("NonExistentKeyword");
        assertTrue(result.isEmpty());
    }
    @Test
    @Tag("integration")
    public void databaseConnectionFailureThrowsException() {
        when(client.getDatabase("telusko")).thenThrow(new RuntimeException("Database connection failed"));
