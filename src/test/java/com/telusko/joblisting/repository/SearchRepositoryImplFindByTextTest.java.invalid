package com.telusko.joblisting.repository;import com.mongodb.client.AggregateIterable;
import com.mongodb.client.MongoClient;
import com.mongodb.client.MongoCollection;
import com.mongodb.client.MongoDatabase;
import com.mongodb.MongoException;
import com.telusko.joblisting.model.Post;
import org.bson.Document;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import org.springframework.data.mongodb.core.convert.MongoConverter;
import java.util.ArrayList;
import java.util.List;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.ArgumentMatchers.eq;
import static org.mockito.Mockito.*;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Component;
import java.util.Arrays;

@ExtendWith(MockitoExtension.class)
class SearchRepositoryImplFindByTextTest {
    @Mock
    private MongoClient client;
    @Mock
    private MongoDatabase database;
    @Mock
    private MongoCollection<Document> collection;
    @Mock
    private AggregateIterable<Document> aggregateIterable;
    @Mock
    private MongoConverter converter;
    
    private SearchRepositoryImpl searchRepository;
    @BeforeEach
    void setUp() {
        // Initialize with default constructor and set fields using reflection
        searchRepository = new SearchRepositoryImpl();
        java.lang.reflect.Field clientField;
        java.lang.reflect.Field converterField;
        try {
            clientField = SearchRepositoryImpl.class.getDeclaredField("client");
            converterField = SearchRepositoryImpl.class.getDeclaredField("converter");
            clientField.setAccessible(true);
            converterField.setAccessible(true);
            clientField.set(searchRepository, client);
            converterField.set(searchRepository, converter);
        } catch (Exception e) {
            fail("Failed to set up test: " + e.getMessage());
        }
        
        when(client.getDatabase("telusko")).thenReturn(database);
        when(database.getCollection("JobPost")).thenReturn(collection);
    }
    @Test
    @Tag("valid")
    public void testFindByTextWithValidInput() {
        Document mockDocument = new Document();
        Post mockPost = new Post();
        
        when(collection.aggregate(any())).thenReturn(aggregateIterable);
        when(aggregateIterable.forEach(any())).thenAnswer(invocation -> {
            ((Block<Document>) invocation.getArgument(0)).apply(mockDocument);
            return null;
        });
        when(converter.read(eq(Post.class), any(Document.class))).thenReturn(mockPost);
        List<Post> result = searchRepository.findByText("Java Developer");
        assertNotNull(result);
        assertFalse(result.isEmpty());
        assertEquals(1, result.size());
    }
    @Test
    @Tag("valid")
    public void testFindByTextWithNoMatches() {
        when(collection.aggregate(any())).thenReturn(aggregateIterable);
        when(aggregateIterable.forEach(any())).thenAnswer(invocation -> null);
        List<Post> result = searchRepository.findByText("NonExistentSkill");
        assertNotNull(result);
        assertTrue(result.isEmpty());
    }
    @Test
    @Tag("invalid")
    public void testFindByTextWithNullInput() {
        when(collection.aggregate(any())).thenReturn(aggregateIterable);
        when(aggregateIterable.forEach(any())).thenAnswer(invocation -> null);
        List<Post> result = searchRepository.findByText(null);
        assertNotNull(result);
        assertTrue(result.isEmpty());
    }
    @Test
    @Tag("boundary")
    public void testFindByTextVerifyResultLimit() {
        List<Document> mockDocuments = new ArrayList<>();
        for (int i = 0; i < 6; i++) {
            mockDocuments.add(new Document());
        }
        
        when(collection.aggregate(any())).thenReturn(aggregateIterable);
        when(aggregateIterable.forEach(any())).thenAnswer(invocation -> {
            for (int i = 0; i < 5; i++) {
                ((Block<Document>) invocation.getArgument(0)).apply(mockDocuments.get(i));
            }
            return null;
        });
        when(converter.read(eq(Post.class), any(Document.class))).thenReturn(new Post());
        List<Post> result = searchRepository.findByText("Common Skill");
        assertNotNull(result);
        assertEquals(5, result.size());
    }
    @Test
    @Tag("integration")
    public void testFindByTextWithDatabaseConnectionFailure() {
        when(client.getDatabase(anyString())).thenThrow(new MongoException("Connection failed"));
        assertThrows(MongoException.class, () -> searchRepository.findByText("Java"));
    }
    @Test
    @Tag("integration")
    public void testFindByTextWithDocumentConversionError() {
        Document mockDocument = new Document();
        
        when(collection.aggregate(any())).thenReturn(aggregateIterable);
        when(aggregateIterable.forEach(any())).thenAnswer(invocation -> {
            ((Block<Document>) invocation.getArgument(0)).apply(mockDocument);
            return null;
        });
        when(converter.read(eq(Post.class), any(Document.class)))
            .thenThrow(new IllegalArgumentException("Conversion failed"));
        assertThrows(IllegalArgumentException.class, () -> searchRepository.findByText("Python"));
    }
}