        // Arrange
        MongoDatabase database = mock(MongoDatabase.class);
        MongoCollection<Document> collection = mock(MongoCollection.class);
        AggregateIterable<Document> result = mock(AggregateIterable.class);
        when(client.getDatabase("telusko")).thenReturn(database);
        when(database.getCollection("JobPost")).thenReturn(collection);
        when(collection.aggregate(anyList())).thenReturn(result);

        // Act & Assert
        assertThrows(NullPointerException.class, () -> searchRepository.findByText(null));
    }

    @Tag("valid")
    @DisplayName("findByText_WithNonExistentText_ReturnsEmptyList")
    @Test
    void findByText_WithNonExistentText_ReturnsEmptyList() {
        // Arrange
        MongoDatabase database = mock(MongoDatabase.class);
        MongoCollection<Document> collection = mock(MongoCollection.class);
        AggregateIterable<Document> result = mock(AggregateIterable.class);
        when(client.getDatabase("telusko")).thenReturn(database);
        when(database.getCollection("JobPost")).thenReturn(collection);
        when(collection.aggregate(anyList())).thenReturn(result);

        // Act
        List<Post> posts = searchRepository.findByText("non-existent-text");

        // Assert
        assertNotNull(posts);
        assertTrue(posts.isEmpty());
    }

    @Tag("valid")
    @DisplayName("findByText_WithSpecialCharacters_ReturnsMatchingPosts")
    @ParameterizedTest
    @ValueSource(strings = {"java!", "python?", "full stack@"})
    void findByText_WithSpecialCharacters_ReturnsMatchingPosts(String text) {
        // Arrange
        MongoDatabase database = mock(MongoDatabase.class);
        MongoCollection<Document> collection = mock(MongoCollection.class);
        AggregateIterable<Document> result = mock(AggregateIterable.class);
        when(client.getDatabase("telusko")).thenReturn(database);
        when(database.getCollection("JobPost")).thenReturn(collection);
        when(collection.aggregate(anyList())).thenReturn(result);

        // Act
        List<Post> posts = searchRepository.findByText(text);

        // Assert
        assertNotNull(posts);
