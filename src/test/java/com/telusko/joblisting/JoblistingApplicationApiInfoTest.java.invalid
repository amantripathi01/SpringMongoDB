package com.telusko.joblisting;import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;
import springfox.documentation.service.ApiInfo;
import springfox.documentation.service.ApiInfoBuilder;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;
import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.context.annotation.Bean;
import org.springframework.web.bind.annotation.RestController;
import springfox.documentation.builders.PathSelectors;
import springfox.documentation.builders.RequestHandlerSelectors;
import springfox.documentation.spi.DocumentationType;
import springfox.documentation.spring.web.plugins.Docket;
import springfox.documentation.swagger2.annotations.EnableSwagger2;
import springfox.documentation.builders.ApiInfoBuilder;

@SpringBootTest
public class JoblistingApplicationApiInfoTest {
    @Autowired
    private JoblistingApplication joblistingApplication;
    @Test
    @Tag("valid")
    public void apiInfoReturnsNonNull() {
        ApiInfo apiInfo = joblistingApplication.apiInfo();
        assertNotNull(apiInfo, "ApiInfo object should not be null");
    }
    @Test
    @Tag("valid")
    public void apiInfoReturnsDefaultValues() {
        ApiInfo apiInfo = joblistingApplication.apiInfo();
        assertEquals("", apiInfo.getTitle(), "Default title should be empty string");
        assertEquals("", apiInfo.getDescription(), "Default description should be empty string");
        assertNull(apiInfo.getTermsOfServiceUrl(), "Default terms of service URL should be null");
        assertNull(apiInfo.getContact(), "Default contact should be null");
        assertNull(apiInfo.getLicense(), "Default license should be null");
        assertNull(apiInfo.getLicenseUrl(), "Default license URL should be null");
        assertEquals("1.0", apiInfo.getVersion(), "Default version should be 1.0");
    }
    @Test
    @Tag("valid")
    public void apiInfoIsIdempotent() {
        ApiInfo apiInfo1 = joblistingApplication.apiInfo();
        ApiInfo apiInfo2 = joblistingApplication.apiInfo();
        assertSame(apiInfo1, apiInfo2, "ApiInfo instances should be the same");
    }
}