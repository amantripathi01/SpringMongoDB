@ExtendWith(MockitoExtension.class)
public class JoblistingApplicationApiInfoTest {
    @InjectMocks
    private JoblistingApplication joblistingApplication;
    @Test
    @Tag("valid")
    public void createsApiInfoWithDefaultValues() {
        ApiInfo apiInfo = joblistingApplication.apiInfo();
        assertNotNull(apiInfo);
    }
    @Test
    @Tag("valid")
    public void usesApiInfoBuilderToBuildApiInfo() {
        ApiInfoBuilder builderMock = mock(ApiInfoBuilder.class);
        when(builderMock.build()).thenReturn(new ApiInfoBuilder().build());
        ApiInfo apiInfo = builderMock.build();
        assertNotNull(apiInfo);
    }
    @Test
    @Tag("valid")
    public void returnsNonNullApiInfo() {
        ApiInfo apiInfo = joblistingApplication.apiInfo();
        assertNotNull(apiInfo);
    }
