        when(repo.findAll()).thenThrow(new RuntimeException("Database error"));
        List<Post> result = postController.getAllPosts();
        assertEquals(new ArrayList<>(), result);
        verify(repo, times(1)).findAll();
    }
    @Test
    @Tag("valid")
    public void getAllPostsReturnsCorrectListWhenMultiplePostsExist() {
        List<Post> mockPosts = new ArrayList<>();
        mockPosts.add(new Post("", "", 1, new String[]{}));
        mockPosts.add(new Post("", "", 1, new String[]{}));
        mockPosts.add(new Post("", "", 1, new String[]{}));
        when(repo.findAll()).thenReturn(mockPosts);
        List<Post> result = postController.getAllPosts();
        assertEquals(mockPosts, result);
        verify(repo, times(1)).findAll();
    }
    @Test
    @Tag("valid")
    public void getAllPostsReturnsCorrectListWhenSinglePostExists() {
