class PostControllerGetAllPostsTest {
    @Mock
    private PostRepository repo;
    @InjectMocks
    private PostController postController;
    @BeforeEach
    void setUp() {
        MockitoAnnotations.openMocks(this);
    }
    @Test
    @Tag("valid")
    public void getAllPostsReturnsAllPosts() {
        List<Post> mockPosts = new ArrayList<>();
        mockPosts.add(new Post("", "", 1, new String[]{}));
        mockPosts.add(new Post("", "", 1, new String[]{}));
        when(repo.findAll()).thenReturn(mockPosts);
        List<Post> result = postController.getAllPosts();
        assertEquals(mockPosts, result);
        verify(repo, times(1)).findAll();
    }
    @Test
    @Tag("valid")
    public void getAllPostsReturnsEmptyListWhenNoPostsExist() {
        when(repo.findAll()).thenReturn(new ArrayList<>());
        List<Post> result = postController.getAllPosts();
        assertEquals(new ArrayList<>(), result);
        verify(repo, times(1)).findAll();
    }
    @Test
    @Tag("invalid")
