package com.telusko.joblisting.controller;import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import javax.servlet.http.HttpServletResponse;
import static org.mockito.Mockito.doThrow;
import static org.mockito.Mockito.verify;
import static org.mockito.Mockito.times;
import com.telusko.joblisting.repository.PostRepository;
import com.telusko.joblisting.model.Post;
import com.telusko.joblisting.repository.SearchRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.*;
import springfox.documentation.annotations.ApiIgnore;
import java.io.IOException;
import java.util.List;

@ExtendWith(MockitoExtension.class)
public class PostControllerRedirectTest {
    
    @InjectMocks
    private PostController postController;
    @Mock
    HttpServletResponse mockHttpServletResponse;
    @Test
    @Tag("valid")
    public void testRedirectToSwaggerUI() {
        try{
            postController.redirect(mockHttpServletResponse);
        }
        catch(IOException e){
            e.printStackTrace();
        }
        verify(mockHttpServletResponse, times(1)).sendRedirect("/swagger-ui.html");
    }
    @Test
    @Tag("invalid")
    public void testIOExceptionOnRedirect() {
        doThrow(new IOException()).when(mockHttpServletResponse).sendRedirect("/swagger-ui.html");
        try {
            postController.redirect(mockHttpServletResponse);
        } catch (IOException e) {
            // Exception is expected here, so no additional handling is required
        }
        verify(mockHttpServletResponse, times(1)).sendRedirect("/swagger-ui.html");
    }
}