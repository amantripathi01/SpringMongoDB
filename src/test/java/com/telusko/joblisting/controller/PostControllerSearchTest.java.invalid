package com.telusko.joblisting.controller;import com.telusko.joblisting.model.Post;
import com.telusko.joblisting.repository.SearchRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import java.util.Arrays;
import java.util.List;
import java.util.ArrayList;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertThrows;
import static org.mockito.Mockito.when;
import org.junit.jupiter.api.*;
import com.telusko.joblisting.repository.PostRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.*;
import springfox.documentation.annotations.ApiIgnore;
import javax.servlet.http.HttpServletResponse;
import java.io.IOException;

public class PostControllerSearchTest {
    @InjectMocks
    PostController postController;
    @Mock
    SearchRepository srepo;
    @BeforeEach
    public void init() {
        MockitoAnnotations.initMocks(this);
    }
    @Tag("valid")
    @Test
    public void testSearchMethodWithValidInput() {
        Post p1 = new Post();
        p1.setProfile("Information Technology");
        p1.setName("Peter");
        p1.setDesc("IT Manager position");
        
        Post p2 = new Post();
        p2.setProfile("Healthcare");
        p2.setName("John");
        p2.setDesc("Nurse Practitioner position");
        
        List<Post> posts = Arrays.asList(p1,p2);
        when(srepo.findByText("position")).thenReturn(posts);
        List<Post> retrievedPosts = postController.search("position");
        assertEquals(posts.size(), retrievedPosts.size(),"The size of the returned posts list does not match the expected size");
        assertEquals(posts, retrievedPosts, "The returned posts list does not match the expected result");
    }
    @Tag("invalid")
    @Test
    public void testSearchMethodWithInvalidInput() {
        List<Post> posts = new ArrayList<>();
        when(srepo.findByText("nonexistent")).thenReturn(posts);
        List<Post> retrievedPosts = postController.search("nonexistent");
        assertEquals(posts.size(), retrievedPosts.size(),"The size of the returned posts list should be zero for invalid input");
    }
    @Tag("boundary")
    @Test
    public void testSearchMethodWithNullInput() {
        when(srepo.findByText(null)).thenThrow(new NullPointerException("Null Text Input!"));
        assertThrows(NullPointerException.class, () -> postController.search(null), "The search method did not throw the expected NullPointerException for a null input");
    }
}