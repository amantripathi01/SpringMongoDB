package com.telusko.joblisting.controller;import com.telusko.joblisting.controller.PostController;
import com.telusko.joblisting.model.Post;
import com.telusko.joblisting.repository.SearchRepository;
import org.junit.jupiter.api.*;
import org.junit.jupiter.params.ParameterizedTest;
import org.junit.jupiter.params.provider.ValueSource;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoSettings;
import org.mockito.quality.Strictness;
import org.springframework.beans.factory.annotation.Autowired;
import java.util.ArrayList;
import java.util.List;
import static org.assertj.core.api.Assertions.assertThat;
import static org.mockito.ArgumentMatchers.anyString;
import static org.mockito.Mockito.*;
import com.telusko.joblisting.repository.PostRepository;
import org.springframework.web.bind.annotation.*;
import springfox.documentation.annotations.ApiIgnore;
import javax.servlet.http.HttpServletResponse;
import java.io.IOException;

@DisplayName("PostControllerSearchTest")
@MockitoSettings(strictness = Strictness.LENIENT)
public class PostControllerSearchTest {
    @InjectMocks
    private PostController postController;
    @Mock
    private SearchRepository searchRepository;
    @Tag("valid")
    @Test
    @DisplayName("searchWithValidText")
    void searchWithValidText() {
        // Arrange
        List<Post> expectedPosts = new ArrayList<>();
        expectedPosts.add(new Post("1", "Software Engineer", "Google", "Mountain View, CA", "Full-time", "2023-03-08"));
        when(searchRepository.findByText(anyString())).thenReturn(expectedPosts);
        // Act
        List<Post> actualPosts = postController.search("Software Engineer");
        // Assert
        assertThat(actualPosts).isNotNull();
        assertThat(actualPosts).hasSize(1);
        assertThat(actualPosts.get(0)).isEqualToComparingFieldByField(expectedPosts.get(0));
    }
    @Tag("valid")
    @ParameterizedTest
    @ValueSource(strings = {"", " "})
    @DisplayName("searchWithEmptyText")
    void searchWithEmptyText(String text) {
        // Arrange
        List<Post> expectedPosts = new ArrayList<>();
        when(searchRepository.findByText(anyString())).thenReturn(expectedPosts);
        // Act
        List<Post> actualPosts = postController.search(text);
        // Assert
        assertThat(actualPosts).isNotNull();
        assertThat(actualPosts).isEmpty();
    }
    @Tag("invalid")
    @Test
    @DisplayName("searchWithNullText")
    void searchWithNullText() {
        // Arrange
        when(searchRepository.findByText(anyString())).thenThrow(NullPointerException.class);
        // Act & Assert
        Assertions.assertThrows(NullPointerException.class, () -> postController.search(null));
    }
    @Tag("valid")
    @Test
    @DisplayName("searchWithSpecialCharacters")
    void searchWithSpecialCharacters() {
        // Arrange
        List<Post> expectedPosts = new ArrayList<>();
        expectedPosts.add(new Post("1", "Data Scientist", "Amazon", "Seattle, WA", "Full-time", "2023-03-15"));
        when(searchRepository.findByText(anyString())).thenReturn(expectedPosts);
        // Act
        List<Post> actualPosts = postController.search("Data Scientist*");
        // Assert
        assertThat(actualPosts).isNotNull();
        assertThat(actualPosts).hasSize(1);
        assertThat(actualPosts.get(0)).isEqualToComparingFieldByField(expectedPosts.get(0));
    }
    @Tag("valid")
    @Test
    @DisplayName("searchWithNonExistentText")
    void searchWithNonExistentText() {
        // Arrange
        List<Post> expectedPosts = new ArrayList<>();
        when(searchRepository.findByText(anyString())).thenReturn(expectedPosts);
        // Act
        List<Post> actualPosts = postController.search("NonExistentText");
        // Assert
        assertThat(actualPosts).isNotNull();
        assertThat(actualPosts).isEmpty();
    }
}