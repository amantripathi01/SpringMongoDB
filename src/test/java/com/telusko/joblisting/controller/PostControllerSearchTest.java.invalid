package com.telusko.joblisting.controller;import com.telusko.joblisting.repository.PostRepository;
import com.telusko.joblisting.model.Post;
import com.telusko.joblisting.repository.SearchRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.*;
import springfox.documentation.annotations.ApiIgnore;
import javax.servlet.http.HttpServletResponse;
import java.io.IOException;
import java.util.List;

public class PostControllerSearchTest {
    
    @Mock
    SearchRepository srepo;
    
    @InjectMocks
    PostController controller;
    @Test
    @Tag("valid")
    public void testSearchByText() {
        Post post = new Post();
        post.setDesc("Example text");
        when(srepo.findByText("Example text")).thenReturn(Arrays.asList(post));
        List<Post> result = controller.search("Example text");
        assertEquals(1, result.size());
        assertEquals("Example text", result.get(0).getDesc());
    }
    @Test
    @Tag("invalid")
    public void testSearchForNonExistingText() {
        when(srepo.findByText("NonExisting text")).thenReturn(Collections.emptyList());
        List<Post> result = controller.search("NonExisting text");
        assertEquals(0, result.size());
    }
    @Test
    @Tag("boundary")
    public void testSearchWithEmptyString() {
        Post post1 = new Post();
        Post post2 = new Post();
        when(srepo.findByText("")).thenReturn(Arrays.asList(post1, post2));
        List<Post> result = controller.search("");
        assertEquals(2, result.size());
    }
    @Test
    @Tag("invalid")
    public void testSearchWithNull() {
        when(srepo.findByText(null)).thenThrow(IllegalArgumentException.class);
        assertThrows(IllegalArgumentException.class, () -> controller.search(null));
    }
}