@SpringBootTest
@MockitoSettings(strictness = Strictness.LENIENT)
public class PostControllerAddPostTest {
    @InjectMocks
    private PostController postController;
    @Mock
    private PostRepository postRepository;
    private MockMvc mockMvc;
    @BeforeEach
    public void setUp() {
        mockMvc = MockMvcBuilders.standaloneSetup(postController).build();
    }
    @ParameterizedTest
    @ValueSource(longs = {1L, 2L, 3L})
    @Tag("valid")
    @DisplayName("Test Scenario 1: Successful Post Addition")
    void addPost_savesPostSuccessfully(Long id) {
        // Arrange
        Post post = new Post();
        post.setId(id);
        post.setTitle("Test Title");
        post.setDescription("Test Description");
        // Act
        Post savedPost = postController.addPost(post);
        // Assert
        assertThat(savedPost).isNotNull();
        assertThat(savedPost.getId()).isEqualTo(id);
    }
    @Test
    @Tag("invalid")
    @DisplayName("Test Scenario 2: Null Post Object Handling")
    void addPost_handlesNullPostGracefully() {
        // Arrange
        Post post = null;
        // Act
        Post savedPost = postController.addPost(post);
        // Assert
        assertThat(savedPost).isNull();
    }
    @Test
    @Tag("invalid")
    @DisplayName("Test Scenario 3: Empty Post Object Handling")
    void addPost_handlesEmptyPostGracefully() {
        // Arrange
        Post post = new Post();
        // Act
        Post savedPost = postController.addPost(post);
        // Assert
        assertThat(savedPost).isNull();
    }
    @Test
    @Tag("invalid")
    @DisplayName("Test Scenario 4: Post with Invalid Data Handling")
    void addPost_handlesInvalidPostDataGracefully() {
        // Arrange
        Post post = new Post();
        post.setId(-1L); // Invalid ID
        post.setTitle(""); // Empty title
        // Act
        Post savedPost = postController.addPost(post);
        // Assert
        assertThat(savedPost).isNull();
    }
}