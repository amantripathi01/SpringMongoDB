package com.telusko.joblisting.controller;import com.telusko.joblisting.repository.PostRepository;
import com.telusko.joblisting.model.Post;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import org.springframework.web.bind.annotation.RequestBody;
import java.util.Optional;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;
import com.telusko.joblisting.repository.SearchRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.*;
import springfox.documentation.annotations.ApiIgnore;
import javax.servlet.http.HttpServletResponse;
import java.io.IOException;
import java.util.List;

public class PostControllerAddPostTest {
    @Mock
    private PostRepository repo;
    @InjectMocks
    private PostController postController;
    public PostControllerAddPostTest() {
        MockitoAnnotations.openMocks(this);
    }
    @Test
    @Tag("valid")
    public void testSuccessfulPostAddition() {
        Post post = new Post();
        post.setProfile("Test Profile");
        post.setDesc("Test Description");
        post.setExp(5);
        post.setTechs(new String[]{"Java", "Spring"});
        when(repo.save(any(Post.class))).thenReturn(post);
        Post result = postController.addPost(post);
        assertNotNull(result);
        assertEquals(post.getProfile(), result.getProfile());
        assertEquals(post.getDesc(), result.getDesc());
        assertEquals(post.getExp(), result.getExp());
        assertArrayEquals(post.getTechs(), result.getTechs());
    }
    @Test
    @Tag("invalid")
    public void testNullPostObject() {
        assertThrows(NullPointerException.class, () -> {
            postController.addPost(null);
        });
    }
    @Test
    @Tag("invalid")
    public void testPostWithMissingFields() {
        Post post = new Post();
        post.setProfile("Test Profile");
        assertThrows(IllegalArgumentException.class, () -> {
            postController.addPost(post);
        });
    }
    @Test
    @Tag("invalid")
    public void testPostWithInvalidData() {
        Post post = new Post();
        post.setProfile("");
        post.setDesc("Test Description");
        assertThrows(IllegalArgumentException.class, () -> {
            postController.addPost(post);
        });
    }
    @Test
    @Tag("invalid")
    public void testDuplicatePostAddition() {
        Post post = new Post();
        post.setProfile("Test Profile");
        post.setDesc("Test Description");
        post.setExp(5);
        post.setTechs(new String[]{"Java", "Spring"});
        when(repo.findById(anyLong())).thenReturn(Optional.of(post));
        when(repo.save(any(Post.class))).thenThrow(new IllegalArgumentException("Duplicate post"));
        assertThrows(IllegalArgumentException.class, () -> {
            postController.addPost(post);
        });
    }
    @Test
    @Tag("valid")
    public void testPostWithSpecialCharacters() {
        Post post = new Post();
        post.setProfile("Test @#$% Profile");
        post.setDesc("Test Description @#$%");
        post.setExp(5);
        post.setTechs(new String[]{"Java", "Spring"});
        when(repo.save(any(Post.class))).thenReturn(post);
        Post result = postController.addPost(post);
        assertNotNull(result);
        assertEquals(post.getProfile(), result.getProfile());
        assertEquals(post.getDesc(), result.getDesc());
        assertEquals(post.getExp(), result.getExp());
        assertArrayEquals(post.getTechs(), result.getTechs());
    }
    @Test
    @Tag("boundary")
    public void testLargePostData() {
        Post post = new Post();
        post.setProfile("Test Profile".repeat(1000));
        post.setDesc("Test Description".repeat(1000));
        post.setExp(5);
        post.setTechs(new String[]{"Java", "Spring"});
        when(repo.save(any(Post.class))).thenReturn(post);
        Post result = postController.addPost(post);
        assertNotNull(result);
        assertEquals(post.getProfile(), result.getProfile());
        assertEquals(post.getDesc(), result.getDesc());
        assertEquals(post.getExp(), result.getExp());
        assertArrayEquals(post.getTechs(), result.getTechs());
    }
    @Test
    @Tag("integration")
    public void testConcurrentPostAdditions() {
        Post post1 = new Post();
        post1.setProfile("Test Profile 1");
        post1.setDesc("Test Description 1");
        post1.setExp(5);
        post1.setTechs(new String[]{"Java", "Spring"});
        Post post2 = new Post();
        post2.setProfile("Test Profile 2");
        post2.setDesc("Test Description 2");
        post2.setExp(5);
        post2.setTechs(new String[]{"Java", "Spring"});
        when(repo.save(any(Post.class))).thenReturn(post1, post2);
        Post result1 = postController.addPost(post1);
        Post result2 = postController.addPost(post2);
        assertNotNull(result1);
        assertEquals(post1.getProfile(), result1.getProfile());
        assertEquals(post1.getDesc(), result1.getDesc());
        assertEquals(post1.getExp(), result1.getExp());
        assertArrayEquals(post1.getTechs(), result1.getTechs());
        assertNotNull(result2);
        assertEquals(post2.getProfile(), result2.getProfile());
        assertEquals(post2.getDesc(), result2.getDesc());
        assertEquals(post2.getExp(), result2.getExp());
        assertArrayEquals(post2.getTechs(), result2.getTechs());
    }
}