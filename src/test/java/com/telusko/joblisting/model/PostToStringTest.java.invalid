package com.telusko.joblisting.model;import org.springframework.data.mongodb.core.mapping.Document;
import java.util.Arrays;

class PostToStringTest {
    @Test
    @Tag("valid")
    void toStringForValidPostObject() {
        Post post = new Post();
        post.setProfile("Software Engineer");
        post.setDesc("Develop and maintain web applications");
        post.setExp(3);
        post.setTechs(new String[]{"Java", "Spring", "React"});
        String expected = "Post{profile='Software Engineer', desc='Develop and maintain web applications', exp=3, techs=[Java, Spring, React]}";
        String actual = post.toString();
        assertEquals(expected, actual);
    }
    @ParameterizedTest
    @MethodSource("providePostObjectsWithNullValues")
    @Tag("invalid")
    void toStringForPostObjectWithNullValues(Post post, String expected) {
        String actual = post.toString();
        assertEquals(expected, actual);
    }
    private static Stream<Arguments> providePostObjectsWithNullValues() {
        return Stream.of(
            Arguments.arguments(new Post(), "Post{profile='null', desc='null', exp=0, techs=null}"),
            Arguments.arguments(createPostWithNullDesc(), "Post{profile='null', desc='null', exp=0, techs=null}"),
            Arguments.arguments(createPostWithNullTechs(), "Post{profile='null', desc='null', exp=0, techs=null}")
        );
    }
    private static Post createPostWithNullDesc() {
        Post post = new Post();
        post.setProfile(null);
        post.setDesc(null);
        return post;
    }
    private static Post createPostWithNullTechs() {
        Post post = new Post();
        post.setProfile(null);
        post.setTechs(null);
        return post;
    }
    @ParameterizedTest
    @MethodSource("providePostObjectsWithEmptyValues")
    @Tag("invalid")
    void toStringForPostObjectWithEmptyValues(Post post, String expected) {
        String actual = post.toString();
        assertEquals(expected, actual);
    }
    private static Stream<Arguments> providePostObjectsWithEmptyValues() {
        return Stream.of(
            Arguments.arguments(createPostWithEmptyProfile(), "Post{profile='', desc='null', exp=0, techs=null}"),
            Arguments.arguments(createPostWithEmptyDesc(), "Post{profile='null', desc='', exp=0, techs=null}"),
            Arguments.arguments(createPostWithEmptyTechs(), "Post{profile='null', desc='null', exp=0, techs=[]}")
        );
    }
    private static Post createPostWithEmptyProfile() {
        Post post = new Post();
        post.setProfile("");
        return post;
    }
    private static Post createPostWithEmptyDesc() {
        Post post = new Post();
        post.setDesc("");
        return post;
    }
    private static Post createPostWithEmptyTechs() {
        Post post = new Post();
        post.setTechs(new String[0]);
        return post;
    }
    @Test
    @Tag("boundary")
    void toStringForPostObjectWithLargeArrayValues() {
        String[] largeTechsArray = new String[10000];
        for (int i = 0; i < 10000; i++) {
            largeTechsArray[i] = "Tech" + i;
        }
        Post post = new Post();
        post.setProfile("Software Architect");
        post.setDesc("Design and implement software systems");
        post.setExp(8);
        post.setTechs(largeTechsArray);
        String actual = post.toString();
        // Assertion: Verify that the toString() method does not throw any exceptions and returns a valid string representation
        Assertions.assertNotNull(actual);
    }
