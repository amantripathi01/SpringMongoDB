package com.telusko.joblisting;import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import springfox.documentation.builders.PathSelectors;
import springfox.documentation.builders.RequestHandlerSelectors;
import springfox.documentation.service.ApiInfo;
import springfox.documentation.spi.DocumentationType;
import springfox.documentation.spring.web.plugins.Docket;
import springfox.documentation.swagger2.annotations.EnableSwagger2;
import static org.junit.jupiter.api.Assertions.assertNotNull;
import static org.mockito.Mockito.verify;
import org.springframework.web.bind.annotation.RestController;
import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.context.annotation.Bean;
import springfox.documentation.builders.ApiInfoBuilder;

@EnableSwagger2
public class JoblistingApplicationApiTest {
    @Tag("integration")
    @Test
    public void docketConfigurationCheck() {
        JoblistingApplication joblistingApplication = Mockito.mock(JoblistingApplication.class);
        
        Docket docket = Mockito.mock(Docket.class, Mockito.RETURNS_DEEP_STUBS);
        
        when(joblistingApplication.api()).thenReturn(docket);
        Docket returnedDocket = joblistingApplication.api();
        
        assertNotNull(returnedDocket);
        verify(docket.select().apis(RequestHandlerSelectors.withClassAnnotation(RestController.class)).paths(PathSelectors.any()).build().useDefaultResponseMessages(false));
    }
    
    @Tag("valid")
    @Test
    public void integrationWithApiInfoCheck() {
        JoblistingApplication joblistingApplication = Mockito.mock(JoblistingApplication.class);
        
        Docket docket = Mockito.mock(Docket.class, Mockito.RETURNS_DEEP_STUBS);
        ApiInfo apiInfo = Mockito.mock(ApiInfo.class);
        
        when(joblistingApplication.api()).thenReturn(docket);
        when(joblistingApplication.apiInfo()).thenReturn(apiInfo);
        
        Docket returnedDocket = joblistingApplication.api();
        
        assertNotNull(returnedDocket);
        verify(docket.apiInfo(apiInfo));
    }
    
    @Tag("boundary")
    @Test
    public void restControllerSelectionCheck() {
        JoblistingApplication joblistingApplication = Mockito.mock(JoblistingApplication.class);
        
        Docket docket = Mockito.mock(Docket.class, Mockito.RETURNS_DEEP_STUBS);
        when(joblistingApplication.api()).thenReturn(docket);
        
        Docket returnedDocket = joblistingApplication.api();
        
        assertNotNull(returnedDocket);
        verify(docket.select().apis(RequestHandlerSelectors.withClassAnnotation(RestController.class)));
    }
}