package com.telusko.joblisting;import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.*;
import org.springframework.test.util.ReflectionTestUtils;
import org.mockito.Mockito;
import org.springframework.boot.SpringApplication;
import springfox.documentation.spring.web.plugins.Docket;
import springfox.documentation.spi.DocumentationType;
import springfox.documentation.service.ApiInfo;
import springfox.documentation.builders.ApiInfoBuilder;
import org.junit.jupiter.api.*;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.context.annotation.Bean;
import org.springframework.web.bind.annotation.RestController;
import springfox.documentation.builders.PathSelectors;
import springfox.documentation.builders.RequestHandlerSelectors;
import springfox.documentation.swagger2.annotations.EnableSwagger2;

public class JoblistingApplicationApiTest {
  
    @Test
    @Tag("valid")
    public void testDocketBeanGeneration() {
        JoblistingApplication joblistingApplication = new JoblistingApplication();
        
        Docket docketGenerated = joblistingApplication.api();
        ApiInfo apiInfo = docketGenerated.apiInfo();
        
        assertNotNull(docketGenerated);
        assertEquals(DocumentationType.SWAGGER_2, docketGenerated.getDocumentationType());
        // Check Docket's selector
        assertNotNull(docketGenerated.getPredicate());
        assertTrue(docketGenerated.getPredicate().evaluate(RequestHandlerSelectors.any().getClass()));
        assertTrue(docketGenerated.getPredicate().evaluate(PathSelectors.any().getClass()));
        // Check ApiInfo
        assertNotNull(apiInfo);
        assertFalse(docketGenerated.getConfiguration().getDefaultResponseMessages().isEmpty());
    }
    @Test
    @Tag("valid")
    public void testSwaggerEnabledCorrectly() {
        JoblistingApplication joblistingApplication = new JoblistingApplication();
        
        Docket docketGenerated = joblistingApplication.api();
        ApiInfo apiInfo = docketGenerated.apiInfo();
        
        assertNotNull(docketGenerated);
        assertEquals(DocumentationType.SWAGGER_2, docketGenerated.getDocumentationType());
        // Check is enabled
        assertNotNull(docketGenerated.getDocumentationType());
        assertFalse(docketGenerated.getDocumentationType().isEmpty());
        // Check Group Name
        assertEquals("default", docketGenerated.getGroupName());
    }
    @Test
    @Tag("valid")
    public void testDocketApiInfo() {
        JoblistingApplication joblistingApplication = new JoblistingApplication();
        
        Docket docketGenerated = joblistingApplication.api();
        
        // Check ApiInfo
        assertNotNull(docketGenerated.apiInfo());
    }
