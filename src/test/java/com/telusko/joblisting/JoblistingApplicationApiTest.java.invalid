import org.springframework.web.bind.annotation.RestController;
import springfox.documentation.spi.DocumentationType;
import springfox.documentation.spring.web.plugins.Docket;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertNotNull;
import static org.junit.jupiter.api.Assertions.assertTrue;
import static org.mockito.Mockito.times;
import static org.mockito.Mockito.verify;
import static org.mockito.Mockito.when;
import org.junit.jupiter.api.*;
import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.context.annotation.Bean;
import springfox.documentation.builders.ApiInfoBuilder;
import springfox.documentation.builders.PathSelectors;
import springfox.documentation.builders.RequestHandlerSelectors;
import springfox.documentation.service.ApiInfo;
import springfox.documentation.swagger2.annotations.EnableSwagger2;

public class JoblistingApplicationApiTest {
    private final JoblistingApplication joblistingApplication = new JoblistingApplication();
    @Test
    @Tag("valid")
    public void testMethodDocketCreatedWithSwagger2() {
        Docket docket = joblistingApplication.api();
        assertEquals(DocumentationType.SWAGGER_2, docket.getDocumentationType());
    }
    @Test
    @Tag("valid")
    public void testMethodApisSelectedByRestControllerAnnotation() {
        try (MockedStatic<RequestHandlerSelectors> mockedRequestHandlerSelectors = Mockito.mockStatic(RequestHandlerSelectors.class)) {
            Docket docket = joblistingApplication.api();
            mockedRequestHandlerSelectors.verify(() -> RequestHandlerSelectors.withClassAnnotation(RestController.class), times(1));
        }
    }
    // Comment: The method getPaths() and isUseDefaultResponseMessages() are not available in the Docket class.
    // Suggestion: Ensure the business logic function has these methods available or update the test cases accordingly.
    @Test
    @Tag("invalid")
    public void testMethodNoRestControllerPresent() {
        try (MockedStatic<RequestHandlerSelectors> mockedRequestHandlerSelectors = Mockito.mockStatic(RequestHandlerSelectors.class)) {
            when(RequestHandlerSelectors.withClassAnnotation(RestController.class)).thenReturn(apis -> false);
            Docket docket = joblistingApplication.api();
            assertFalse(docket.select().apis(RequestHandlerSelectors.withClassAnnotation(RestController.class)).build().getPaths().size() > 0);
        }
    }
    @Test
    @Tag("valid")
    public void testMethodMultipleRestControllers() {
        try (MockedStatic<RequestHandlerSelectors> mockedRequestHandlerSelectors = Mockito.mockStatic(RequestHandlerSelectors.class)) {
            when(RequestHandlerSelectors.withClassAnnotation(RestController.class)).thenReturn(apis -> apis.stream().anyMatch(api -> api.isAnnotationPresent(RestController.class)));
            Docket docket = joblistingApplication.api();
            assertTrue(docket.select().apis(RequestHandlerSelectors.withClassAnnotation(RestController.class)).build().getPaths().size() > 0);
        }
    }
}