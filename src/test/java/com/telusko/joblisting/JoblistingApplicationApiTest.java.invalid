        when(joblistingApplication.apiInfo()).thenReturn(apiInfo);
    }
    
    @Test
    @Tag("valid")
    public void testDocketConfigurationWithDefaultSettings() {
        Docket docket = joblistingApplication.api();
        
        assertNotNull(docket);
        assertEquals(DocumentationType.SWAGGER_2, docket.getDocumentationType());
    }
    
    @Test
    @Tag("integration")
    public void testDocketConfigurationWithApiInfo() {
        Docket docket = joblistingApplication.api();
        
        assertNotNull(docket);
        verify(joblistingApplication, times(1)).apiInfo();
    }
    
    @Test
    @Tag("valid")
    public void testRequestHandlerSelectionConfiguration() {
        Docket docket = joblistingApplication.api();
        
        assertNotNull(docket);
        assertTrue(docket.select().build().getDocumentationType() != null);
    }
    
    @Test
    @Tag("valid")
    public void testPathSelectionConfiguration() {
        Docket docket = joblistingApplication.api();
        
        assertNotNull(docket);
        assertTrue(docket.select().build().getDocumentationType() != null);
    }
    
    @Test
