    @Test
    @Tag("DocketCreation")
    public void testApiMethodForFailures() {
        JoblistingApplication jobAppMock = mock(JoblistingApplication.class);
        when(jobAppMock.api()).thenThrow(RuntimeException.class);
        assertThrows(RuntimeException.class, () -> {
            jobAppMock.api();
        }, "Expected exception not thrown.");
    } 
    @Test
    @Tag("DocketConfiguration")
    public void testDocketBeanConfiguration() {
        JoblistingApplication jobApp = new JoblistingApplication();
        Docket docket = jobApp.api();
        assertTrue(docket.getDocumentationType().equals(DocumentationType.SWAGGER_2), "Unexpected Documentation Type.");
        // assertTrue(RequestHandlerSelectors.withClassAnnotation(RestController.class).equals(docket.getRequestBodyPredicate()), "Unexpected RequestHandlerSelector.");
