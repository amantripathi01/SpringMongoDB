package com.telusko.joblisting;import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.springframework.boot.test.context.SpringBootTest;
import springfox.documentation.builders.RequestHandlerSelectors;
import springfox.documentation.builders.PathSelectors;
import springfox.documentation.service.ApiInfo;
import springfox.documentation.spi.DocumentationType;
import springfox.documentation.spring.web.plugins.Docket;
import org.springframework.web.bind.annotation.RestController;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;
import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.context.annotation.Bean;
import springfox.documentation.builders.ApiInfoBuilder;
import springfox.documentation.swagger2.annotations.EnableSwagger2;

@SpringBootTest
public class JoblistingApplicationApiTest {
    private final JoblistingApplication joblistingApplication = new JoblistingApplication();
    @Test
    @Tag("valid")
    public void docketBeanCreationSuccessfully() {
        Docket docket = joblistingApplication.api();
        assertNotNull(docket, "Docket bean should not be null");
        assertTrue(docket instanceof Docket, "Returned object should be an instance of Docket");
    }
    @Test
    @Tag("valid")
    public void docketHasCorrectDocumentationType() {
        Docket docket = joblistingApplication.api();
        assertEquals(DocumentationType.SWAGGER_2, docket.getDocumentationType(), "Docket should be configured with SWAGGER_2 documentation type");
    }
    @Test
    @Tag("valid")
    public void docketSelectsRestControllerApis() {
        Docket docket = joblistingApplication.api();
        assertNotNull(docket, "Docket should not be null");
        assertEquals(RequestHandlerSelectors.withClassAnnotation(RestController.class).getClass(), docket.getDocumentationType().getClass(), "Docket should select APIs with @RestController annotation");
    }
    @Test
    @Tag("valid")
    public void docketIncludesAllPaths() {
        Docket docket = joblistingApplication.api();
        assertNotNull(docket, "Docket should not be null");
        assertEquals(PathSelectors.any().getClass(), docket.getDocumentationType().getClass(), "Docket should include all API paths");
    }
    @Test
    @Tag("valid")
    public void docketUsesApiInfoConfiguration() {
        Docket docket = joblistingApplication.api();
        ApiInfo apiInfo = docket.getApiInfo();
        assertNotNull(apiInfo, "Docket should have an ApiInfo object configured");
    }
    @Test
    @Tag("valid")
    public void docketDisablesDefaultResponseMessages() {
        Docket docket = joblistingApplication.api();
        assertNotNull(docket, "Docket should not be null");
        assertFalse(docket.isEnabled(), "Docket should disable default response messages");
    }
}